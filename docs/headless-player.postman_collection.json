    {
      "name": "Playback",
      "item": [
        {
          "name": "Prepare Faststart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"sample.mp4\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/faststart/prepare",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "faststart",
                "prepare"
              ]
            }
          }
        },
        {
          "name": "Faststart Go",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/faststart/go?seconds=0.5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "faststart",
                "go"
              ],
              "query": [
                {
                  "key": "seconds",
                  "value": "0.5"
                }
              ]
            }
          }
        },
        {
          "name": "Apply Playlist",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    \"sample.mp4\",\n    \"backup.mp4\"\n  ],\n  \"loop\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/playlist/apply",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "playlist",
                "apply"
              ]
            }
          }
        },
        {
          "name": "Playlist Status",
          "request": {
