{
  "info": {
    "name": "Headless Player API",
    "description": "Collection of common headless-player commands including display mode control and playback helpers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": {
      "major": 1,
      "minor": 0,
      "patch": 0
    }
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "udpHost",
      "value": "127.0.0.1"
    },
    {
      "key": "udpPort",
      "value": "7777"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Get Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "status"
              ]
            }
          }
        },
        {
          "name": "List Media",
          "request": {
            "method": "GET",
            "header": [],
