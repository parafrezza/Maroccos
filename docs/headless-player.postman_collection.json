                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_hz\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/display/mode/force_720p",
