{
  "info": {
    "name": "Headless Player API (Updated)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    { "name": "healthz", "request": { "method": "GET", "url": "{{base_url}}/healthz" } },
    { "name": "status", "request": { "method": "GET", "url": "{{base_url}}/status" } },
    { "name": "framework get", "request": { "method": "GET", "url": "{{base_url}}/framework" } },
  { "name": "change framework (immediate)", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/change_framework", "body": {"mode": "raw", "raw": "{\n  \"name\": \"mpv\"\n}" } } },
    { "name": "change framework (scheduled)", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/change_framework", "body": {"mode": "raw", "raw": "{\n  \"name\": \"gst\",\n  \"in_time\": {{epoch_future}}\n}" } } },
    { "name": "play", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/play", "body": { "mode": "raw", "raw": "{\n  \"filename\": \"clip.mp4\",\n  \"loop\": false,\n  \"fade_in_seconds\": 0.6,\n  \"fade_out_seconds\": 0.4\n}" } } },
    { "name": "play scheduled (epoch)", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/play", "body": {"mode": "raw", "raw": "{\n  \"filename\": \"clip.mp4\",\n  \"in_time\": {{epoch_future}},\n  \"fade_out_seconds\": 0.5,\n  \"fade_in_seconds\": 0.5\n}"}}},
    { "name": "play scheduled (delay 5s)", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/play", "body": {"mode": "raw", "raw": "{\n  \"filename\": \"clip.mp4\",\n  \"in_time\": 5,\n  \"fade_out_seconds\": 0.3\n}"}}},
    { "name": "ping (flash)", "request": { "method": "POST", "url": "{{base_url}}/ping?duration_ms=120" } },
    { "name": "ping scheduled (delay)", "request": { "method": "POST", "url": "{{base_url}}/ping?duration_ms=150&in_time=3" } },
    { "name": "ping scheduled (epoch)", "request": { "method": "POST", "url": "{{base_url}}/ping?duration_ms=150&in_time={{epoch_future}}" } },
    { "name": "pause", "request": { "method": "POST", "url": "{{base_url}}/pause" } },
    { "name": "resume", "request": { "method": "POST", "url": "{{base_url}}/resume" } },
    { "name": "loop on", "request": { "method": "POST", "url": "{{base_url}}/loop?on=1" } },
    { "name": "loop off", "request": { "method": "POST", "url": "{{base_url}}/loop?on=0" } },
    { "name": "fade in", "request": { "method": "POST", "url": "{{base_url}}/fade_in?seconds=1.0" } },
    { "name": "fade out", "request": { "method": "POST", "url": "{{base_url}}/fade_out?seconds=1.0" } },
  { "name": "overlay show (alpha=1)", "request": { "method": "POST", "url": "{{base_url}}/overlay/show?alpha=1.0" } },
  { "name": "overlay hide", "request": { "method": "POST", "url": "{{base_url}}/overlay/hide" } },
  { "name": "overlay fade to 0 in 1s", "request": { "method": "POST", "url": "{{base_url}}/overlay/fade?target=0&seconds=1" } },
  { "name": "overlay fade to 1 in 1s", "request": { "method": "POST", "url": "{{base_url}}/overlay/fade?target=1&seconds=1" } },
  { "name": "faststart prepare (by filename)", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/faststart/prepare", "body": {"mode": "raw", "raw": "{\n  \"filename\": \"clip.mp4\"\n}" } } },
  { "name": "faststart go (fade-out overlay 1s)", "request": { "method": "POST", "url": "{{base_url}}/faststart/go?seconds=1" } },
  { "name": "get device name", "request": { "method": "GET", "url": "{{base_url}}/device/name" } },
  { "name": "set device name", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/device/name", "body": {"mode": "raw", "raw": "{\n  \"name\": \"Player-01\"\n}" } } },
  { "name": "test on", "request": { "method": "POST", "url": "{{base_url}}/test/on" } },
  { "name": "test off", "request": { "method": "POST", "url": "{{base_url}}/test/off" } },
    { "name": "media list", "request": { "method": "GET", "url": "{{base_url}}/media" } },
    { "name": "media clear (POST)", "request": {"method": "POST", "url": "{{base_url}}/media/clear?confirm=1"}},
    { "name": "media clear (GET)",  "request": {"method": "GET",  "url": "{{base_url}}/media/clear?confirm=1"}},
    { "name": "media playlist (create)", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/media/playlist", "body": {"mode": "raw", "raw": "{\n  \"loop\": true\n}" } } },
    { "name": "playlist status", "request": {"method": "GET", "url": "{{base_url}}/playlist/status"}},
    { "name": "playlist next", "request": {"method": "POST", "url": "{{base_url}}/playlist/next"}},
    { "name": "playlist prev", "request": {"method": "POST", "url": "{{base_url}}/playlist/prev"}},
    { "name": "playlist loop on", "request": {"method": "POST", "url": "{{base_url}}/playlist/loop?on=1"}},
    { "name": "playlist loop off", "request": {"method": "POST", "url": "{{base_url}}/playlist/loop?on=0"}},
    { "name": "download asset (POST JSON)", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/download_asset", "body": {"mode": "raw", "raw": "{\n  \"url\": \"{{asset_url}}\",\n  \"filename\": \"clip.mp4\"\n}" } } },
    { "name": "download asset (GET)", "request": { "method": "GET", "url": "{{base_url}}/download_asset?url={{asset_url}}&filename=clip.mp4" } },
    { "name": "download update (POST JSON)", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/download_update", "body": {"mode": "raw", "raw": "{\n  \"url\": \"{{update_url}}\",\n  \"version\": \"{{update_version}}\",\n  \"callback_url\": \"{{callback_url}}\",\n  \"start_at\": {{epoch_future}}\n}" } } },
    { "name": "download update (GET)", "request": { "method": "GET", "url": "{{base_url}}/download_update?url={{update_url}}&version={{update_version}}&callback_url={{callback_url}}&start_at={{epoch_future}}" } },
    { "name": "apply update", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/update", "body": { "mode": "raw", "raw": "{ \n  \"restart\": true\n}" } } },
    { "name": "apply update (scheduled)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{base_url}}/update", "body": { "mode": "raw", "raw": "{ \n  \"restart\": true,\n  \"start_at\": {{epoch_future}}\n}" } } },
    { "name": "settings reload (video caps)", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/settings/reload", "body": {"mode": "raw", "raw": "{\n  \"USE_KMS\": false,\n  \"USE_HW_DECODER\": true,\n  \"TARGET_WIDTH\": 1280,\n  \"TARGET_HEIGHT\": 720,\n  \"TARGET_FPS\": \"25/1\",\n  \"restart_play\": true\n}" } } },
  { "name": "settings enable UDP", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/settings/reload", "body": {"mode": "raw", "raw": "{\n  \"UDP_ENABLED\": true\n}" } } },
  { "name": "settings disable UDP", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/settings/reload", "body": {"mode": "raw", "raw": "{\n  \"UDP_ENABLED\": false\n}" } } },
    { "name": "hide splash", "request": {"method": "POST", "url": "{{base_url}}/hide_splash"}},
    { "name": "maintenance run_setup", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/maintenance/run_setup", "body": {"mode": "raw", "raw": "{ \"force\": true }" } } },
    { "name": "maintenance status", "request": {"method": "GET", "url": "{{base_url}}/maintenance/status"}},
    { "name": "ethernet status", "request": {"method": "GET", "url": "{{base_url}}/network/ethernet/status"}},
    { "name": "ethernet config", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "url": "{{base_url}}/network/ethernet/config", "body": {"mode": "raw", "raw": "{\n  \"ip_cidr\": \"192.168.1.50/24\",\n  \"gateway\": \"\",\n  \"dns\": \"\"\n}" } } },
    { "name": "system reboot", "request": { "method": "POST", "url": "{{base_url}}/system/reboot" } }
  ],
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8080" },
    { "key": "asset_url", "value": "http://127.0.0.1:8000/media/s1.mp4" },
    { "key": "update_url", "value": "http://127.0.0.1:8000/releases/latest.zip" },
    { "key": "update_version", "value": "v0.1.0" },
    { "key": "callback_url", "value": "http://127.0.0.1:9999/callback" },
    { "key": "epoch_future", "value": "1730400000" }
  ]
}
